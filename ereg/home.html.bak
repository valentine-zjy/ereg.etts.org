                                 };

                                 // Bundle titles
                                 var bundleTitles = {
                                     'GRE_BUNDLE_BASIC': 'Essentials Bundle',
                                     'GRE_BUNDLE_TOTAL_ACCESS': 'Total Access Bundle',
                                     'GRE_BUNDLE_PREMIUM': 'Complete Prep Bundle'
                                 };
                                 var bundleImages = {
                                     'GRE_BUNDLE_BASIC': 'img/bundle_essentials.png',
                                     'GRE_BUNDLE_TOTAL_ACCESS': 'img/bundle_total_access.png',
                                     'GRE_BUNDLE_PREMIUM': 'img/bundle_complete_prep.png'
                                 };

                                 function viewBundleDetails(bundleId) {
                                       var content = bundleDescriptions[bundleId];
                                       var title = bundleTitles[bundleId];
                                       var image = bundleImages[bundleId];
                                       addRemoveBundleGA4('select', bundleId);
                                       if (content && title) {
                                          document.getElementById('bundleModalTitle').textContent = title;
                                          document.getElementById('bundleModalContent').innerHTML = content;

                                          var priceElement;
                                          if (bundleId === 'GRE_BUNDLE_BASIC') {
                                             priceElement = document.getElementById('basicCurrentPrice');
                                          } else if (bundleId === 'GRE_BUNDLE_TOTAL_ACCESS') {
                                             priceElement = document.getElementById('totalAccessCurrentPrice');
                                          } else if (bundleId === 'GRE_BUNDLE_PREMIUM') {
                                             priceElement = document.getElementById('premiumCurrentPrice');
                                          }

                                          if (priceElement) {
                                             document.getElementById('bundleModalPrice').textContent = priceElement.textContent;
                                          }

                                          // Set the bundle image
                                          document.getElementById('bundleProductImage').innerHTML =
                                             '<img src="' + image + '" alt="' + title + '" />';

                                          // Update modal button and remove link dynamically
                                          var addToCartBtn = document.getElementById('bundleModalAddButton');
                                          var removeLink = document.getElementById('bundleModalRemoveLink');

                                          if (addToCartBtn && removeLink) {
                                             // Set onclick handlers for the specific bundle
                                             addToCartBtn.setAttribute('onclick', "addBundleToCart('" + bundleId + "')");
                                             removeLink.setAttribute('onclick', "removeBundleFromCart('" + bundleId + "')");

                                             // Update button styling based on bundle type
                                             if (bundleId === 'GRE_BUNDLE_TOTAL_ACCESS') {
                                                addToCartBtn.className = 'btn btn-bundle-add-to-cart btn-bundle-add-to-cart-main';
                                                addToCartBtn.innerHTML = 'ADD TO CART <img src="img/cart-white-icon.png" alt="" style="max-width: 100%; max-height: 100%;" />';
                                             } else {
                                                addToCartBtn.className = 'btn btn-bundle-add-to-cart btn-bundle-add-to-cart-side';
                                                addToCartBtn.innerHTML = 'ADD TO CART <img src="img/cart-purple-icon.png" alt="" style="max-width: 100%; max-height: 100%;" />';
                                             }

                                             // Check current cart status and show appropriate button/link
                                             var bundleInCart = false;
                                             if (bundleId === 'GRE_BUNDLE_BASIC' && bundleBasicAdded) bundleInCart = true;
                                             else if (bundleId === 'GRE_BUNDLE_TOTAL_ACCESS' && bundleTotalAccessAdded) bundleInCart = true;
                                             else if (bundleId === 'GRE_BUNDLE_PREMIUM' && bundlePremiumAdded) bundleInCart = true;

                                             if (bundleInCart) {
                                                addToCartBtn.style.display = 'none';
                                                removeLink.style.display = 'inline-flex';
                                             } else {
                                                addToCartBtn.style.display = 'flex';
                                                removeLink.style.display = 'none';
                                             }
                                          }
                                          // product Viewed event
                                          addRemoveBundleGA4('viewed', bundleId);;

                                          // Clear any previous message
                                          showBundleModalMessage('', 'info');

                                          // Use fadeIn
                                          $('#bundleDetailsModal').fadeIn();
                                       }
                                    }

                                    // New function to show messages in the bundle modal
                                       function showBundleModalMessage(message, type) {
                                          var messageDiv = document.getElementById('bundleModalMessage');
                                          if (messageDiv) {
                                             if (message) {
                                                messageDiv.innerHTML = '<div class="bundle-message-content bundle-message-' + type + '"></div>';
                                                messageDiv.firstChild.textContent = message;
                                                messageDiv.style.display = 'block';

                                                // Auto-hide after 5 seconds for success/error messages
                                                if (type === 'success' || type === 'error') {
                                                   setTimeout(function () {
                                                      messageDiv.style.display = 'none';
                                                   }, 5000);
                                                }
                                             } else {
                                                messageDiv.style.display = 'none';
                                             }
                                          }
                                       }

                                 function closeBundleModal() {
                                     // Use fadeOut
                                     $('#bundleDetailsModal').fadeOut();
                                 }

                                 // Update the document ready function to handle bundle modal close
                                 $(document).ready(function () {
                                     // Existing code...

                                     // Add bundle modal close handlers (similar to notifyModal)
                                     $('.bundle-modal .close').click(function () {
                                         $('#bundleDetailsModal').fadeOut();
                                     });

                                     // Close bundle modal when clicking outside (like notifyModal background click)
                                     $('#bundleDetailsModal').click(function(event) {
                                         if (event.target === this) {
                                             $('#bundleDetailsModal').fadeOut();
                                         }
                                     });

                                     // Close modal with Escape key
                                     $(document).keydown(function(event) {
                                         if (event.key === 'Escape') {
                                             $('#bundleDetailsModal').fadeOut();
                                         }
                                     });
                                 });


                                function isEmptyArray(arr){
                                 return Array.isArray(arr) && arr.length==0;
                                }

                                var availFeatureProds='[{"skuId":6505,"name":"GRE Mentor Prep Course","description":"Unlock your success with this self-paced course that customizes a prep plan to your test date. Includes progress tracker, quizzes and a full-length practice test.<br>","priceDescription":"<b>$149 USD</b>.","retailPrice":100.0,"currencyCode":"USD","delivaryType":"Subscription","defalutCategoryName":"Digital Courses","defaultCategoryId":2045,"fulfillmentType":"TPOS_TEST_PREP","itemType":"eBook","formateName":"Official GRE Mentor Course","imageUrl":"https://store.ets.org/DRHM/Storefront/Company/ets/images/product/detail/GRE/digital_gre_mentor.png","defaultPrice":149,"format":"Subscription"}]';
                                var itemArray;
                                var items=[];
                                var currencyCode;
                                try{
                                  itemArray = JSON.parse(availFeatureProds);
                                    if(!isEmptyArray(itemArray)){
                                    itemArray.forEach(item => {
                                          currencyCode = item.currencyCode;
                                          var item = {
                                             item_id: item.skuId,
                                             item_name: item.formateName,
                                             affiliation: "",
                                             coupon: "",
                                             discount: 0,
                                             index: 0,
                                             item_brand: "GRE",
                                             item_category: item.defalutCategoryName,
                                             item_category2: item.fulfillmentType,
                                             item_category3: item.delivaryType,
                                             item_list_id: item.defaultCategoryId,
                                             item_list_name: item.defalutCategoryName,
                                             item_variant: item.itemType,
                                             price: stringToFinancialNumber(item.retailPrice),
                                             quantity: 1
                                          };
                                          items.push(item);
                                       });
                                       // Update bundle pricing based on detected currency
                                       updateBundlePricingByCurrency(currencyCode);
                                    }
                                } catch (e) {
                                    // Fallback to server currency or USD
                                    currencyCode = '' || 'USD';
                                    updateBundlePricingByCurrency(currencyCode);
                                 }
                                 // Make sure currencyCode is available globally
                                 window.globalCurrencyCode = currencyCode;
                                 // for
                                 var commonData={
                                      page_category : "Test Takers",
                                      brand : "GRE",
                                      site_language :"English",
                                      user_status: user_status,
                                      customer_id: customer_id,
                                      custom_timestamp : Date.now(),
                                      ga_client_id: 'auto',
                                      userProgram:'GRI',
                                 };
                                 function featureProductGTM(skuId,param) {
                                    if (enableGTM && !isEmptyArray(items)) {
                                       var item = items.find(id => id.item_id == skuId);
                                       etsAL.push({
                                          event: param == 'featureAdd' ? "add_to_cart" : 'view_promotion',
                                          ...commonData,
                                          ecommerce: {
                                             ...(param !== 'featureAdd' && {
                                                creative_name: creativeName,
                                                creative_slot: creativeSlot,
                                                promotion_name: promotionName
                                             }),
                                             ...(param == 'featureAdd' && {
                                                currency: currencyCode,
                                                value: stringToFinancialNumber(item.price)
                                             }),
                                             items: [item]
                                          }
                                       });
                                    }
                                 }

                                 function addFeatureProductSegementEvent(skuId){
                                              var segmentEventName = 'Product Added';
                                              var segmentPayload;
                                              itemArray = JSON.parse(availFeatureProds);
                                              if(!isEmptyArray(itemArray)) {
                                                 var item=itemArray[0];
                                                 segmentPayload = {
                                                    userId:    "151cedd8e078104bbbf4f6132e15d310",
                                                    source:    "ERS",
                                                    category:  item.defalutCategoryName,
                                                    position: '',
                                                    sku: item.skuId,
                                                    name: item.formateName,
                                                    brand: 'GRE',
                                                    variant: item.format || '',
                                                    price: stringToFinancialNumber(item.defaultPrice),
                                                    currency: item.currencyCode,
                                                    quantity: 1,
                                                    coupon: '',
                                                    url: window.location.href,
                                                    image_url: item.imageUrl,
                                                 };
                                              }

                                              if (window.analytics && typeof window.analytics.track === 'function') {
                                                  window.analytics.track(segmentEventName, segmentPayload);
                                              } else {
                                                  console.warn('Segment analytics not available for feature product event:', segmentEventName);
                                              }
                                     }
                             var promotionName='Test Prep PPC Campaign';
                             var creativeName ='gre mentor prep 12 month text';
                             var creativeSlot ='top centre box';


                    document.addEventListener('click', function(e){
                       var icon = e.target.closest('.icon-wrapper');
                       if(icon){
                          var li = icon.closest('li.list-group-item');
                          if(li){
                             var link = li.querySelector('a[href]');
                             if(link){
                                link.click();
                                link.focus();
                             }
                          }
                       }
                    });

                    function trackProductClicked(type) {
                        var categoryMap = {
                            'register':        { category: 'Graduate Record Examination', name: 'Test Registration', variant: 'Test Registration',sku:'2554',price:'249.00' },
                            'additionalScore': { category: 'Additional Score Report', name: 'Additional Score Report Fees', variant: 'Additional Score Report',sku:'2626',price:'40.00' }
                        };
                        var data = categoryMap[type] || { category: '', name: '', variant: '' };
                        if (window.analytics && typeof window.analytics.track === 'function') {
                            window.analytics.track('Product Clicked', {
                                userId:    '151cedd8e078104bbbf4f6132e15d310',
                                source:    'ERS',
                                sku:       data.sku || '',
                                category:  data.category,
                                name:      data.name,
                                brand:     'GRE',
                                variant:   data.variant,
                                price:     data.price || '',
                                currency:  currencyCode || 'USD',
                                quantity:  1,
                                coupon:    '',
                                position:  '',
                                url:       window.location.href,
                                image_url: 'img/cart-purple-icon.png'
                            });
                        }
                    }

                    function addRemoveBundleGA4(param, bundleId)
                    {
                     var index=0;
                     var items=[];
                     var value=0;
                     var currencyCode='';
                     var selectedBundle='';
                     var bundlePosition='';
                     if('GRE_BUNDLE_BASIC'==bundleId){
                      selectedBundle=bundle1;
                      bundlePosition=1;
                      }
                       if('GRE_BUNDLE_TOTAL_ACCESS'==bundleId){
                       selectedBundle=bundle2;
                       bundlePosition=2;
                       }
                      if('GRE_BUNDLE_PREMIUM'== bundleId){
                       selectedBundle=bundle3;
                       bundlePosition=3;
                       }
                          selectedBundle.forEach(item=>{
                                 var itemId = {
                                        item_id: item.skuId,
                                        item_name: item.name,
                                        affiliation: "",
                                        coupon: "",
                                        discount: 0,
                                        index: index++,
                                        item_brand: "GRE",
                                        item_category: item.categoryName,
                                        item_category2: item.fulfillmentType,
                                        item_category3: item.variant,
                                        item_list_id: item.defaultCategoryId,
                                        item_list_name: item.categoryName,
                                        item_variant: item.variant,
                                        price: stringToFinancialNumber(item.price),
                                        quantity: 1
                                     };
                                     value=value+stringToFinancialNumber(item.price);
                                     currencyCode=item.currencyCode;
                                    items.push(itemId);

;
                          });
                            if(enableGTM && items.length>0 ){
                                 etsAL.push({
                                            event : (param =="add" ? "add_to_cart" : (param == "remove" ? "remove_from_cart": "select_item")),
                                            ...commonData,
                                        ecommerce:{
                                               creative_slot : 'Homepage',
                                               currency : currencyCode,
                                               value : value,
                                               items : items
                                        }
                                  });

                             }

                             // Send Segment event for add and remove bundle actions
                             if (items.length > 0) {
                             const eventType = {
                               add: 'Product Added',
                               remove: 'Product Removed',
                               viewed: 'Product Viewed'
                             };
                             var segmentEventName = eventType[param] || 'Product Clicked';
                                 var bundleProducts =  [];
                                 selectedBundle.forEach(item=>{
                                    var itemId = {
                                        sku:       item.skuId,
                                        category:  item.categoryName || '',
                                        name:      item.name ,
                                        brand:     'GRE',
                                        variant:   item.variant || '',
                                        price:     item.price,
                                        currency:  item.currencyCode,
                                        quantity:  1,
                                        coupon:    '',
                                        url:       window.location.href,
                                        image_url: item.imageUrl,
                                        };
                                        bundleProducts.push(itemId);
                                 });
                                 var segmentPayload = {
                                     userId:    "151cedd8e078104bbbf4f6132e15d310",
                                     source:    "ERS",
                                     category:  bundleTitles[bundleId],
                                     position: bundlePosition,
                                     products:  bundleProducts,
                                 };
                                 if (window.analytics && typeof window.analytics.track === 'function') {
                                     window.analytics.track(segmentEventName, segmentPayload);
                                 } else {
                                     console.warn('Segment analytics not available for bundle event:', segmentEventName);
                                 }
                             }
                    }
 </script>



        	function normalizeSegmentValue(value) {
            	if (value === undefined || value === null) return undefined;
            	if (typeof value === 'string') {
            		var trimmedValue = value.trim();
            		if (!trimmedValue || trimmedValue === 'null' || trimmedValue === 'undefined') return undefined;
            		return trimmedValue;
            	}
            	return value;
            }

            function normalizeSegmentPrivacyAcknowledgement(value) {
            	var normalizedValue = normalizeSegmentValue(value);
            	var normalizedLower = normalizedValue.toLowerCase();
            	if (normalizedLower === 'y') return true;
            	if (normalizedLower === 'n') return false;
            }

            function normalizeSegmentBoolean(value) {
            	var normalizedValue = normalizeSegmentValue(value);
            	if (normalizedValue === undefined) return undefined;
            	if (typeof normalizedValue === 'boolean') return normalizedValue;
            	if (typeof normalizedValue === 'string') {
            		var normalizedLower = normalizedValue.toLowerCase();
            		if (normalizedLower === 'true' || normalizedLower === 'y') return true;
            		if (normalizedLower === 'false' || normalizedLower === 'n') return false;
            	}
            	return undefined;
            }

            function normalizeProfilePhoneType(phoneTypeCode) {
            	var normalizedPhoneType = normalizeSegmentValue(phoneTypeCode);
            	if (normalizedPhoneType === undefined) return undefined;
            	var phoneTypeUpper = String(normalizedPhoneType).toUpperCase();
            	if (phoneTypeUpper === 'M') return 'Mobile';
            	if (phoneTypeUpper === 'L') return 'Landline';
            	return normalizedPhoneType;
            }

            function normalizeProfileGender(genderCode) {
            	var normalizedGender = normalizeSegmentValue(genderCode);
            	if (normalizedGender === undefined) return undefined;
            	var genderUpper = String(normalizedGender).toUpperCase();
            	if (genderUpper === 'F') return 'Female';
            	if (genderUpper === 'M') return 'Male';
            	if (genderUpper === 'U') return 'Undisclosed';
            	if (genderUpper === 'S') return 'Prefer to self-describe';
            	if (genderUpper === 'N') return 'Prefer not to answer';
            	if (genderUpper === 'X') return 'Non-binary';
            	return normalizedGender;
            }

            function buildDOB(birthDay, birthMonth, birthYear) {
                var dayValue = normalizeSegmentValue(birthDay);
                var monthValue = normalizeSegmentValue(birthMonth);
                var yearValue = normalizeSegmentValue(birthYear);

                if (dayValue === undefined || monthValue === undefined || yearValue === undefined) {
                    return undefined;
                }

                var day = String(dayValue).padStart(2, '0');
                var month = String(monthValue).padStart(2, '0');
                return String(yearValue) + '-' + month + '-' + day;
            }

            function normalizeProfilePhoneWithIsd(phoneNumber, isdCode) {
            	var normalizedPhoneNumber = normalizeSegmentValue(phoneNumber);
            	var normalizedIsdCode = normalizeSegmentValue(isdCode);
            	if (normalizedPhoneNumber === undefined || normalizedIsdCode === undefined) return undefined;

            	var phoneDigits = String(normalizedPhoneNumber).replace(/\D/g, '');
            	var isdDigits = String(normalizedIsdCode).replace(/\D/g, '');
            	if (!phoneDigits || !isdDigits) return undefined;

            	return '+' + isdDigits + phoneDigits;
            }



        	function stripUndefined(obj) {
            	var result = {};
            	Object.keys(obj).forEach(function (key) {
            		if (obj[key] !== undefined) result[key] = obj[key];
            	});
            	return result;
            }

            function identifyAnalyticsUser() {
            	if (!customer_id || customer_id === 'null' || customer_id === 'undefined') return;
				var amplitudeUserId = normalizeSegmentValue(userId) || normalizeSegmentValue(customer_id);
            	var identifyKey = 'analytics_identified_' + customer_id;
            	try {
            		if (window.sessionStorage && sessionStorage.getItem(identifyKey) === 'true') return;
            	} catch (e) { }
				if (typeof window.amplitudeIdentify === 'function') {

            		var addressTraits = stripUndefined({
            			country: normalizeSegmentValue(profile_address_country),
            			street1: normalizeSegmentValue(profile_address_street1),
            			street2: normalizeSegmentValue(profile_address_street2),
            			street3: normalizeSegmentValue(profile_address_street3),
            			street4: normalizeSegmentValue(profile_address_street4),
            			city: normalizeSegmentValue(profile_address_city),
            			state: normalizeSegmentValue(profile_address_state),
            			postalCode: normalizeSegmentValue(profile_address_postal_code),
            		});

            		var hasAddress = Object.keys(addressTraits).length > 0;

            		var identifyTraits = stripUndefined({
            			userId: normalizeSegmentValue(userId),
            			source: normalizeSegmentValue(profile_source) || 'GRE',
            			firstName: normalizeSegmentValue(profile_first_name),
            			middleName: normalizeSegmentValue(profile_middle_name),
            			lastName: normalizeSegmentValue(profile_last_name),
            			birthday: buildDOB(birthDay, birthMonth, birthYear),
            			gender: normalizeProfileGender(profile_gender),
            			describeYourGender: normalizeSegmentValue(profile_describe_gender),
            			email: normalizeSegmentValue(profile_email),
            			greId: normalizeSegmentValue(greId),
            			address: hasAddress ? addressTraits : undefined,
            			phone1: normalizeProfilePhoneWithIsd(profile_phone1, primaryPhoneISDCode),
            			phoneExtension1: normalizeSegmentValue(profile_phone_extension1),
            			phoneType1: normalizeProfilePhoneType(profile_phone_type1),
            			phone2: normalizeProfilePhoneWithIsd(profile_phone2, alternativePhoneISDCode),
            			phoneExtension2: normalizeSegmentValue(profile_phone_extension2),
            			phoneType2: normalizeProfilePhoneType(profile_phone_type2),
            			smsOptIn: normalizeSegmentBoolean(profile_sms_opt_in),
            			promotionalOptIn: normalizeSegmentBoolean(profile_promotional_opt_in),
            			userName: normalizeSegmentValue(profile_username),
            			privacyAcknowledgement: normalizeSegmentPrivacyAcknowledgement(profile_privacy_acknowledgement),
            		});
					var handleIdentifyAcceptance = function(accepted) {
						if (accepted === false) return;
						try {
							if (window.sessionStorage) {
								sessionStorage.setItem(identifyKey, 'true');
							}
						} catch (e) { }
					};
					window.amplitudeIdentify(amplitudeUserId, identifyTraits, handleIdentifyAcceptance);
					return;
            	}
            }

        	
        		const segmentWriteKey ='TVCbgYKXf6cggJbL7a3XyIWDmtGn6Hny';
        		const segmentUrl= 'https://cdn.segment.com/analytics.js/v1/';
        	
        </script>


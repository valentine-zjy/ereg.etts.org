                                 // Update getCartStatus to ensure only one bundle is marked as added
                                    function getCartStatus() {
                                       var customerId = (typeof customer_id !== 'undefined' && customer_id) ? customer_id : '5RGB62E8';
                                       $.ajax({
                                          type: 'GET',
                                          url: '/ereg/api/customers/' + customerId + '/cart',
                                          success: function (cart) {
                                             // Reset all bundle states first
                                             bundleBasicAdded = false;
                                             bundleTotalAccessAdded = false;
                                             bundlePremiumAdded = false;
                                             bundleOrderItems = {};

                                             if (cart && cart.orderItems && cart.orderItems.length > 0) {
                                                var cartSkuIds = cart.orderItems.map(item => item.skuId);

                                                // Use dynamic bundle data instead of hardcoded
                                                var bundleSkuMap = {
                                                   GRE_BUNDLE_BASIC: bundle1.map(item => item.skuId),
                                                   GRE_BUNDLE_TOTAL_ACCESS: bundle2.map(item => item.skuId),
                                                   GRE_BUNDLE_PREMIUM: bundle3.map(item => item.skuId)
                                                };

                                                function isBundleInCart(bundleSkus) {
                                                   return bundleSkus.every(sku => cartSkuIds.includes(sku));
                                                }

                                                function getOrderItemIdsForBundle(bundleSkus) {
                                                    return cart.orderItems
                                                        .filter(item => bundleSkus.includes(item.skuId))
                                                        .map(item => item.orderItemId);
                                                }

                                                // Check bundles in priority order (Total Access > Premium > Basic)
                                                // This ensures if multiple bundles are somehow in cart, we only recognize the highest priority one
                                                var bundleFound = false;

                                                if (!bundleFound && isBundleInCart(bundleSkuMap.GRE_BUNDLE_TOTAL_ACCESS)) {
                                                   bundleTotalAccessAdded = true;
                                                   bundleOrderItems['GRE_BUNDLE_TOTAL_ACCESS'] = getOrderItemIdsForBundle(bundleSkuMap.GRE_BUNDLE_TOTAL_ACCESS);
                                                   toggleBundleButtons('GRE_BUNDLE_TOTAL_ACCESS', true);
                                                   console.log('Total Access Bundle: Added to cart');
                                                   bundleFound = true;
                                                }

                                                if (!bundleFound && isBundleInCart(bundleSkuMap.GRE_BUNDLE_PREMIUM)) {
                                                   bundlePremiumAdded = true;
                                                   bundleOrderItems['GRE_BUNDLE_PREMIUM'] = getOrderItemIdsForBundle(bundleSkuMap.GRE_BUNDLE_PREMIUM);
                                                   toggleBundleButtons('GRE_BUNDLE_PREMIUM', true);
                                                   console.log('Premium Bundle: Added to cart');
                                                   bundleFound = true;
                                                }

                                                if (!bundleFound && isBundleInCart(bundleSkuMap.GRE_BUNDLE_BASIC)) {
                                                   bundleBasicAdded = true;
                                                   bundleOrderItems['GRE_BUNDLE_BASIC'] = getOrderItemIdsForBundle(bundleSkuMap.GRE_BUNDLE_BASIC);
                                                   toggleBundleButtons('GRE_BUNDLE_BASIC', true);
                                                   console.log('Basic Bundle: Added to cart');
                                                   bundleFound = true;
                                                }

                                                // Ensure all other bundles show "Add to Cart" button
                                                if (!bundleBasicAdded) {
                                                   toggleBundleButtons('GRE_BUNDLE_BASIC', false);
                                                }
                                                if (!bundleTotalAccessAdded) {
                                                   toggleBundleButtons('GRE_BUNDLE_TOTAL_ACCESS', false);
                                                }
                                                if (!bundlePremiumAdded) {
                                                   toggleBundleButtons('GRE_BUNDLE_PREMIUM', false);
                                                }
                                             } else {
                                                // Cart is empty - ensure all bundles show "Add to Cart"
                                                toggleBundleButtons('GRE_BUNDLE_BASIC', false);
                                                toggleBundleButtons('GRE_BUNDLE_TOTAL_ACCESS', false);
                                                toggleBundleButtons('GRE_BUNDLE_PREMIUM', false);
                                             }
                                          },
                                          error: function (xhr) {
                                             console.error('Cart fetch error:', xhr.status, xhr.responseText);
                                          }
                                       });
                                    }
                                       // Function to update bundle pricing based on currency
                                          function updateBundlePricingByCurrency(currency) {
                                             if (currency === 'INR') {
                                                bundlePricing = {
                                                   'GRE_BUNDLE_BASIC': {
                                                      current: 14732,
                                                      original: 16906,
                                                      currency: 'INR'
                                                   },
                                                   'GRE_BUNDLE_TOTAL_ACCESS': {
                                                      current: 22025,
                                                      original: 39703,
                                                      currency: 'INR'
                                                   },
                                                   'GRE_BUNDLE_PREMIUM': {
                                                      current: 17376,
                                                      original: 24788,
                                                      currency: 'INR'
                                                   }
                                                };
                                             } else {
                                                // Default to USD
                                                bundlePricing = {
                                                   'GRE_BUNDLE_BASIC': {
                                                      current: 169,
                                                      original: 193,
                                                      currency: 'USD'
                                                   },
                                                   'GRE_BUNDLE_TOTAL_ACCESS': {
                                                      current: 249,
                                                      original: 448,
                                                      currency: 'USD'
                                                   },
                                                   'GRE_BUNDLE_PREMIUM': {
                                                      current: 199,
                                                      original: 283,
                                                      currency: 'USD'
                                                   }
                                                };
                                             }

                                             // Update the UI prices after setting the bundlePricing
                                             updateBundlePricesInUI(currency);
                                          }

                                          // Function to update bundle prices in the UI
                                          function updateBundlePricesInUI(currency) {
                                             // Update Basic Bundle prices
                                             var basicPricing = bundlePricing['GRE_BUNDLE_BASIC'];
                                             if (basicPricing) {
                                                var basicCurrentElement = document.getElementById('basicCurrentPrice');
                                                var basicCurrencyElement = document.getElementById('basicCurrency');
                                                var basicOriginalElement = document.getElementById('basicOriginalPrice');

                                                if (basicCurrentElement) {
                                                   basicCurrentElement.textContent = formatCurrency(basicPricing.current, currency);
                                                }
                                                if (basicCurrencyElement) {
                                                   basicCurrencyElement.textContent = currency;
                                                }
                                                if (basicOriginalElement) {
                                                   basicOriginalElement.textContent = formatOriginalPrice(basicPricing.original, currency);
                                                }
                                             }

                                             // Update Total Access Bundle prices
                                             var totalAccessPricing = bundlePricing['GRE_BUNDLE_TOTAL_ACCESS'];
                                             if (totalAccessPricing) {
                                                var totalAccessCurrentElement = document.getElementById('totalAccessCurrentPrice');
                                                var totalAccessCurrencyElement = document.getElementById('totalAccessCurrency');
                                                var totalAccessOriginalElement = document.getElementById('totalAccessOriginalPrice');

                                                if (totalAccessCurrentElement) {
                                                   totalAccessCurrentElement.textContent = formatCurrency(totalAccessPricing.current, currency);
                                                }
                                                if (totalAccessCurrencyElement) {
                                                   totalAccessCurrencyElement.textContent = currency;
                                                }
                                                if (totalAccessOriginalElement) {
                                                   totalAccessOriginalElement.textContent = formatOriginalPrice(totalAccessPricing.original, currency);
                                                }
                                             }

                                             // Update Premium Bundle prices
                                             var premiumPricing = bundlePricing['GRE_BUNDLE_PREMIUM'];
                                             if (premiumPricing) {
                                                var premiumCurrentElement = document.getElementById('premiumCurrentPrice');
                                                var premiumCurrencyElement = document.getElementById('premiumCurrency');
                                                var premiumOriginalElement = document.getElementById('premiumOriginalPrice');

                                                if (premiumCurrentElement) {
                                                   premiumCurrentElement.textContent = formatCurrency(premiumPricing.current, currency);
                                                }
                                                if (premiumCurrencyElement) {
                                                   premiumCurrencyElement.textContent = currency;
                                                }
                                                if (premiumOriginalElement) {
                                                   premiumOriginalElement.textContent = formatOriginalPrice(premiumPricing.original, currency);
                                                }
                                             }
                                          }

                                          // Function to format currency display
                                             function formatCurrency(amount, currencyCode) {
                                                if (currencyCode === 'INR') {
                                                   return '鈧? + amount.toLocaleString('en-IN');
                                                } else {
                                                   return '$' + amount.toFixed(2);
                                                }
                                             }

                                             // Function to format currency for original price
                                             function formatOriginalPrice(amount, currencyCode) {
                                                if (currencyCode === 'INR') {
                                                   return '鈧? + amount.toLocaleString('en-IN') + ' INR';
                                                } else {
                                                   return '$' + amount.toFixed(2) + ' USD';
                                                }
                                             }

                                       // Function to calculate discount percentage
                                       function calculateBundleDiscount(bundleId) {
                                          var pricing = bundlePricing[bundleId];
                                          if (pricing && pricing.original > pricing.current) {
                                             var discount = ((pricing.original - pricing.current) / pricing.original) * 100;
                                             return Math.round(discount);
                                          }
                                          return 0;
                                       }

                                       // Function to update bundle discount displays
                                          function updateBundleDiscounts() {
                                             // Update Basic Bundle
                                             var basicDiscount = calculateBundleDiscount('GRE_BUNDLE_BASIC');
                                             var basicDiscountElement = document.getElementById('basicBundleDiscount');
                                             if (basicDiscountElement) {
                                                basicDiscountElement.textContent = '(Save ' + basicDiscount + '%)';
                                             }

                                             // Update Total Access Bundle
                                             var totalAccessDiscount = calculateBundleDiscount('GRE_BUNDLE_TOTAL_ACCESS');
                                             var totalAccessDiscountElement = document.getElementById('totalAccessBundleDiscount');
                                             if (totalAccessDiscountElement) {
                                                totalAccessDiscountElement.textContent = '(Save ' + totalAccessDiscount + '%)';
                                             }

                                             // Update Premium Bundle
                                             var premiumDiscount = calculateBundleDiscount('GRE_BUNDLE_PREMIUM');
                                             var premiumDiscountElement = document.getElementById('premiumBundleDiscount');
                                             if (premiumDiscountElement) {
                                                premiumDiscountElement.textContent = '(Save ' + premiumDiscount + '%)';
                                             }
                                          }

                                 function dobCheck() {
                                    $("#dobMissing").show();
                                 }


                                 function loadingScreen() {
                                    $("#deniedButton").hide();
                                    $("#confirmedButton").hide();
                                    $("#pendingRegistration").modal("hide");
                                    $("#loadingWidget").show();
                                 }
                                 function removeColClasses(selector) {
                                    $(selector).removeClass(function (index, css) {
                                       return (css.match(/\bcol-\S+/g) || []).join(' ');
                                    });
                                 }


                                 function addItemToCart(idValue) {
                                     featureProductGTM(idValue,'promotion');
                                    var testCenterCountryCode = "";
                                    var testCenterId = null;
                                    var testPrepListVo = { selectedProducts: [], bypassDuplicateCheck: false };
                                    testPrepListVo.selectedProducts.push({ skuId: idValue, quantity: 1 });
                                    var data = JSON.stringify(testPrepListVo);
                                    $('#selectedProductsId').val(data);
                                    $('#selectedCountryCd').val(testCenterCountryCode);
                                    $('#selectedTestCenterId').val(testCenterId);
                                    $('#addFeatureProdFlowId').val("true");
                                    $.ajax({
                                       type: 'POST',
                                       url: '/ereg/public/testPrep/addFeatureProdToCart',
                                       data: $('form#testPrep').serialize(),
                                       success: function (data) {

                                          if (data === "success") {
                                           featureProductGTM(idValue,'featureAdd');
                                             addFeatureProductSegementEvent(idValue);
                                             $('#alertContent').html("Item added to Cart!");
                                             $('#addItem').fadeIn();
                                          } else if (data === "failed") {
                                             $('#alertContent').html("Item not added to Cart");
                                             $('#addItem').fadeIn();
                                          }
                                       },
                                       error: function (xhr, status, error) {
                                          $('#alertContent').html("Item not added to Cart");
                                          $('#addItem').fadeIn();
                                          console.log(error);

                                       }
                                    });
                                 }

                                    function addBundleToCart(bundleName) {
                                       $("#loadingWidget").show();
                                       // First, check if any other bundles are in cart and remove them
                                       removeOtherBundlesFromCart(bundleName, function () {
                                          // After removing other bundles, add the new one
                                          addSingleBundleToCart(bundleName);
                                       });
                                    }

                                    function removeOtherBundlesFromCart(currentBundleName, callback) {
                                          var bundlesToRemove = [];

                                          // Check which bundles need to be removed
                                          if (currentBundleName !== 'GRE_BUNDLE_BASIC' && bundleBasicAdded) {
                                             bundlesToRemove.push('GRE_BUNDLE_BASIC');
                                          }
                                          if (currentBundleName !== 'GRE_BUNDLE_TOTAL_ACCESS' && bundleTotalAccessAdded) {
                                             bundlesToRemove.push('GRE_BUNDLE_TOTAL_ACCESS');
                                          }
                                          if (currentBundleName !== 'GRE_BUNDLE_PREMIUM' && bundlePremiumAdded) {
                                             bundlesToRemove.push('GRE_BUNDLE_PREMIUM');
                                          }

                                          if (bundlesToRemove.length === 0) {
                                             callback();
                                             return;
                                          }

                                          var removeCount = 0;
                                          var totalToRemove = bundlesToRemove.length;

                                          function onBundleRemoved() {
                                             removeCount++;
                                             if (removeCount === totalToRemove) {
                                                callback();
                                             }
                                          }

                                          // Remove each bundle
                                          bundlesToRemove.forEach(function (bundleToRemove) {
                                             removeBundleFromCartSilent(bundleToRemove, onBundleRemoved);
                                          });
                                       }

               function removeBundleFromCartSilent(bundleName, callback) {
                     var customerId = (typeof customer_id !== 'undefined' && customer_id) ? customer_id : '5RGB62E8';
                     var orderItemIds = bundleOrderItems[bundleName];

                     if (!orderItemIds || orderItemIds.length === 0) {
                        console.log('No order items found for bundle:', bundleName);
                        callback();
                        return;
                     }

                     if (typeof orderItemIds === 'string') {
                        orderItemIds = orderItemIds.split(',').map(function (id) { return id.trim(); }).filter(Boolean);
                     }

                     var removed = [];
                     var failed = [];
                     var REMOVE_MAX_RETRY_ATTEMPTS = 5;
                     var REMOVE_RETRY_DELAY = 1000; // 1 second

                     removeNextSilently(0);
                     function removeNextSilently(index) {
                        if (index >= orderItemIds.length) {
                           if (failed.length === 0) {
                              // Update bundle state
                              if (bundleName === 'GRE_BUNDLE_BASIC') {
                                 bundleBasicAdded = false;
                                 console.log('Basic bundle removed');
                              }
                              else if (bundleName === 'GRE_BUNDLE_TOTAL_ACCESS') {
                                 bundleTotalAccessAdded = false;
                                 console.log('Total Access bundle removed');
                              }
                              else if (bundleName === 'GRE_BUNDLE_PREMIUM') {
                                 bundlePremiumAdded = false;
                                 console.log('Premium bundle removed');
                              }
                              addRemoveBundleGA4('remove', bundleName);
                              delete bundleOrderItems[bundleName];
                              toggleBundleButtons(bundleName, false);
                           } else {
                              bundleOrderItems[bundleName] = failed.slice();
                              console.warn('Bundle partially removed:', bundleName, 'Failed items:', failed);
                           }
                           callback();
                           return;
                        }

                        var currentId = orderItemIds[index];
                        tryRemoveProductSilent(currentId, 0);

                        function tryRemoveProductSilent(orderItemId, retryCount) {
                           $.ajax({
                              type: 'DELETE',
                              url: '/ereg/api/customers/' + customerId + '/order-items/' + orderItemId + '?source=homePage',
                              contentType: 'application/json; charset=utf-8',
                              success: function () {
                                 removed.push(orderItemId);
                                 removeNextSilently(index + 1);
                              },
                              error: function (xhr) {
                                 isOrderItemRemovedFromCart(orderItemId, customerId, function (removedFromCart) {
                                    if (removedFromCart) {
                                       removed.push(orderItemId);
                                       removeNextSilently(index + 1);
                                       return; // Skip retry
                                    }
                                    if (retryCount < REMOVE_MAX_RETRY_ATTEMPTS - 1) {
                                       var nextRetry = retryCount + 1;
                                       console.warn('Silent remove failed for item:', orderItemId, 'Retrying... (Attempt', nextRetry + 1, 'of', REMOVE_MAX_RETRY_ATTEMPTS, ')');
                                       setTimeout(function () {
                                          tryRemoveProductSilent(orderItemId, nextRetry);
                                       }, REMOVE_RETRY_DELAY * (nextRetry + 1));
                                    } else {
                                       console.error('Failed to silently remove item after retries:', orderItemId, xhr.status);
                                       failed.push(orderItemId);
                                       removeNextSilently(index + 1);
                                    }
                                 });
                              }
                           });
                        }
                     }
                  }

               function addSingleBundleToCart(bundleName) {
                      var MAX_RETRY_ATTEMPTS = 5;
                      var RETRY_DELAY = 1000;

                      var bundleSkuMap = {
                         GRE_BUNDLE_BASIC: bundle1.map(item => item.skuId),
                         GRE_BUNDLE_TOTAL_ACCESS: bundle2.map(item => item.skuId),
                         GRE_BUNDLE_PREMIUM: bundle3.map(item => item.skuId)
                      };

                      var skuIds = bundleSkuMap[bundleName] || [];
                      if (skuIds.length === 0) {
                         console.warn('Unknown bundle:', bundleName);
                         $("#loadingWidget").hide();
                         return;
                      }

                      var customerId = (typeof customer_id !== 'undefined' && customer_id) ? customer_id : '5RGB62E8';

                      // Build payload with all SKUs at once
                     var orderItems = skuIds.map(function(skuId) {
                        return {
                           skuId: skuId,
                           quantity: 1,
                           type: 'TEST_PREP',
                           bypassDuplicateCheck: false,
                           attempt: 1,
                           bundleSource: 'homepage',
                        };
                     });

                      tryBulkAdd(0);

                      function tryBulkAdd(retryCount) {
                         $.ajax({
                            type: 'POST',
                            url: '/ereg/api/customers/' + customerId + '/order-items?source=homePage',
                            data: JSON.stringify(orderItems),
                            contentType: 'application/json; charset=utf-8',
                            dataType: 'json',
                            timeout: 30000,
                            success: function (resp, textStatus, xhr) {
                               var createdOrderItemsUrl = xhr.getResponseHeader('Createdorderitemsurl');
                               var addedOrderItemIds = [];
                               if (createdOrderItemsUrl) {
                                  addedOrderItemIds = createdOrderItemsUrl
                                     .split(',')
                                     .map(function (path) {
                                        path = path.trim();
                                        return path.substring(path.lastIndexOf('/') + 1);
                                     })
                                     .filter(function (id) { return id && /\d+/.test(id); });
                               }

                               bundleOrderItems[bundleName] = addedOrderItemIds;
                               if (bundleName === 'GRE_BUNDLE_BASIC') bundleBasicAdded = true;
                               else if (bundleName === 'GRE_BUNDLE_TOTAL_ACCESS') bundleTotalAccessAdded = true;
                               else if (bundleName === 'GRE_BUNDLE_PREMIUM') bundlePremiumAdded = true;
                               toggleBundleButtons(bundleName, true);
                               $("#loadingWidget").hide();
                               showBundleModalMessage('All items added to Cart!', 'success');
                               $('#alertContent').text('All items added to Cart!');
                               $('#addItem').fadeIn();
                               addRemoveBundleGA4('add', bundleName);
                               getCartStatus();
                            },
                            error: function (xhr, status, error) {
                               // Do not retry 409 (duplicate/unavailable items)
                               if (xhr.status === 409) {
                                  console.error('Bulk add failed with 409 (duplicate/unavailable). Not retrying.');
                                  $("#loadingWidget").hide();
                                  showBundleModalMessage('One or more items are no longer available.', 'error');
                                  $('#alertContent').text('One or more items are no longer available.');
                                  $('#addItem').fadeIn();
                                  return;
                               }
                               if (retryCount < MAX_RETRY_ATTEMPTS - 1) {
                                  console.warn('Bulk add failed, Retrying... (Attempt', retryCount + 1, 'of', MAX_RETRY_ATTEMPTS, ')');
                                  setTimeout(function () {
                                     tryBulkAdd(retryCount + 1);
                                  }, RETRY_DELAY * (retryCount + 1));
                               } else {
                                  console.error('Failed to add bundle items to Cart after retries.');
                                  $("#loadingWidget").hide();
								          showBundleModalMessage('Bundle items could not be added to Cart.', 'error');
							             $('#alertContent').text('Bundle items could not be added to Cart.');
                                  $('#addItem').fadeIn();
                               }
                            }
                         });
                      }
                   }

                                 // Helper to toggle Add/Remove buttons for bundles
                                    function toggleBundleButtons(bundleName, inCart) {
                                          var addBtnSelector = "button.btn.btn-bundle-add-to-cart[onclick*='" + bundleName + "']";
                                          var removeLinkSelector = "a.bundle-view-details-link[onclick*='removeBundleFromCart'][onclick*='" + bundleName + "']";

                                          var addBtn = document.querySelector(addBtnSelector);
                                          var removeLink = document.querySelector(removeLinkSelector);

                                          // Update main page buttons
                                          if (addBtn && removeLink) {
                                             if (inCart) {
                                                addBtn.style.display = 'none';
                                                removeLink.style.display = 'inline-flex';
                                             } else {
                                                addBtn.style.display = 'flex';
                                                removeLink.style.display = 'none';
                                             }
                                          }

                                          // Update modal buttons if modal is open
                                          var modalAddBtn = document.getElementById('bundleModalAddButton');
                                          var modalRemoveLink = document.getElementById('bundleModalRemoveLink');

                                          if (modalAddBtn && modalRemoveLink) {
                                             // Check if the modal is currently showing this bundle
                                             var modalOnclick = modalAddBtn.getAttribute('onclick');
                                             if (modalOnclick && modalOnclick.includes(bundleName)) {
                                                if (inCart) {
                                                   modalAddBtn.style.display = 'none';
                                                   modalRemoveLink.style.display = 'inline-flex';
                                                } else {
                                                   modalAddBtn.style.display = 'flex';
                                                   modalRemoveLink.style.display = 'none';
                                                }
                                             }
                                          }
                                       }

               // This removeBundleFromCart function for manual removal
                  function removeBundleFromCart(bundleName) {
                     $("#loadingWidget").show();
                     var customerId = (typeof customer_id !== 'undefined' && customer_id) ? customer_id : '5RGB62E8';
                     var orderItemIds = bundleOrderItems[bundleName];

                     if (!orderItemIds || orderItemIds.length === 0) {
                        console.error('No order items found for bundle:', bundleName);
                        showBundleModalMessage('No items found to remove from cart', 'error');
                        $("#loadingWidget").hide();
                        return;
                     }

                     if (typeof orderItemIds === 'string') {
                        orderItemIds = orderItemIds.split(',').map(function (id) { return id.trim(); }).filter(Boolean);
                     }

                     var removed = [];
                     var failed = [];
                     var REMOVE_MAX_RETRY_ATTEMPTS = 5;
                     var REMOVE_RETRY_DELAY = 1000; // 1 second
                     removeProductAtIndex(0);
                     function removeProductAtIndex(index) {
                        if (index >= orderItemIds.length) {
                           if (failed.length === 0) {
                              // Update bundle state
                              if (bundleName === 'GRE_BUNDLE_BASIC') { bundleBasicAdded = false; }
                              else if (bundleName === 'GRE_BUNDLE_TOTAL_ACCESS') { bundleTotalAccessAdded = false; }
                              else if (bundleName === 'GRE_BUNDLE_PREMIUM') { bundlePremiumAdded = false; }
                              delete bundleOrderItems[bundleName];
                              toggleBundleButtons(bundleName, false);
                              $("#loadingWidget").hide();
                              addRemoveBundleGA4('remove', bundleName);
                              showBundleModalMessage('Item removed from Cart!', 'success');
                              $('#alertContent').html('Item removed from Cart!');
                           } else {
                              bundleOrderItems[bundleName] = failed.slice();
                              console.warn('Bundle partially removed:', bundleName, 'Failed items:', failed);
                              $("#loadingWidget").hide();
                              showBundleModalMessage('Some Bundle Item not removed from Cart!', 'error');
                              $('#alertContent').html('Some Bundle Item not removed from Cart!');
                           }
                           $('#addItem').fadeIn();
                           getCartStatus();
                           return;
                        }

                        var currentId = orderItemIds[index];
                        tryRemoveProduct(currentId, 0);

                        function tryRemoveProduct(orderItemId, retryCount) {
                           $.ajax({
                              type: 'DELETE',
                              url: '/ereg/api/customers/' + customerId + '/order-items/' + orderItemId + '?source=homePage',
                              contentType: 'application/json; charset=utf-8',
                              success: function () {
                                 removed.push(orderItemId);
                                 removeProductAtIndex(index + 1);
                              },
                              error: function (xhr) {
                                 isOrderItemRemovedFromCart(orderItemId, customerId, function(removedFromCart) {
                                    if (removedFromCart) {
                                       console.log("Item already removed frrom cart");
                                       removed.push(orderItemId);
                                       removeProductAtIndex(index + 1);
                                       return; // Skip retry
                                    }
                                    if (retryCount < REMOVE_MAX_RETRY_ATTEMPTS - 1) {
                                       var nextRetry = retryCount + 1;
                                       console.warn('Remove failed for item:', orderItemId, 'Retrying... (Attempt', nextRetry + 1, 'of', REMOVE_MAX_RETRY_ATTEMPTS, ')');
                                       setTimeout(function () {
                                          tryRemoveProduct(orderItemId, nextRetry);
                                       }, REMOVE_RETRY_DELAY * (nextRetry + 1));
                                    } else {
                                       console.error('Failed to remove item after retries:', orderItemId, xhr.status);
                                       failed.push(orderItemId);
                                       removeProductAtIndex(index + 1);
                                    }
                                 });
                              }
                           });
                        }
                     }

                  }

                  function isOrderItemRemovedFromCart(orderItemId, customerId, callback) {
                     $.ajax({
                        type: 'GET',
                        url: '/ereg/api/customers/' + customerId + '/cart',
                        success: function (cart) {
                           if (cart && cart.orderItems && cart.orderItems.length > 0) {
                              var notInCart = !cart.orderItems.some(function (item) {
                                 return item.orderItemId == orderItemId;
                              });
                              callback(notInCart);
                           } else {
                              callback(true);
                           }
                        },
                        error: function () {
                           callback(false);
                        }
                     });
                  }

                                 // Bundle descriptions
                                 var bundleDescriptions = {
                                     'GRE_BUNDLE_BASIC': `<div class="tw-mb-10 tw-text-neutral-700 [&_h4]:tw-mb-2 [&_li]:tw-mb-1 [&_p:has(+ul)]:tw-mb-2 [&_p:has(+ul)]:tw-mt-6 [&_p]:tw-mb-3 [&_ul]:tw-ml-5 [&_ul]:tw-list-disc">

                              <script type="text/javascript">
                                                var bundleBasicAdded = false;
                                                var bundleTotalAccessAdded = false;
                                                var bundlePremiumAdded = false;
                                                var bundleOrderItems = {};

// Bundle arrays similar to TestPrepBundle.tsx
    var bundle1 = []; // GRE_BUNDLE_BASIC
    var bundle2 = []; // GRE_BUNDLE_TOTAL_ACCESS
    var bundle3 = []; // GRE_BUNDLE_PREMIUM
    var bundleReady = false;

    var productList = [];

 // Initialize bundles with product IDs (matching TestPrepBundle.tsx approach)
function initializeBundles() {
    // Initialize product list first
    initializeProductList();

    var hasMentor = false;
   // Check for mentor course availability
   if (productList && productList.length > 0) {
      for (var i = 0; i < productList.length; i++) {
         var category = productList[i];
         // Check if category name or slug matches mentor course patterns
         if (category.attributes.SLUG === 'new-off-gre-mentor-course' || category.attributes.SLUG === 'mentor-course' || category.attributes.SLUG === 'digital-courses') {
            hasMentor = true;
            break;
         }
      }
   }
   console.log('Has Mentor Course:', hasMentor);
   var showBundleSection = false;
   var showBundleValue = 'Y';
   if ((showBundleValue === 'Y' || showBundleValue === 'Yes') && hasMentor) {
      showBundleSection = true;
      if (!productList || productList.length === 0) {
      // Hide the bundle section on the client side if no products are available
      showBundleSection = false;
      }
   }
   if (!showBundleSection) {
      var dashboardMiddleBody = document.getElementById('dashboard-middle-body');
      if (dashboardMiddleBody) {
         dashboardMiddleBody.style.display = 'none';
      }
      return;
   } else {
      var dashboardMiddleBody = document.getElementById('dashboard-middle-body');
      if (dashboardMiddleBody) {
         dashboardMiddleBody.style.display = 'block';
      }
   }

    // Clear existing bundles
    bundle1 = [];
    bundle2 = [];
    bundle3 = [];

    // Based on the API response, here are the product IDs we need:
    // Product ID 1150: Official GRE Mentor Course (SKU: 6505)
    var mentorCourse = findSkuByProductId(1150);
    if (mentorCourse) {
        bundle1.push(mentorCourse);
        bundle2.push(mentorCourse);
        bundle3.push(mentorCourse);
    }

    // Product ID 1166: POWERPREP PLUS Practice Test 1 (SKU: 5477)
    var practiceTest1 = findSkuByProductId(1166);
    if (practiceTest1) {
        bundle1.push(practiceTest1);
        bundle2.push(practiceTest1);
        bundle3.push(practiceTest1);
    }

    // Bundle 2 (Total Access) and Bundle 3 (Premium) additional items
    // Product ID 1149: POWERPREP PLUS Practice Test 2 (SKU: 5472)
    var practiceTest2 = findSkuByProductId(1149);
    if (practiceTest2) {
        bundle2.push(practiceTest2);
        bundle3.push(practiceTest2);
    }

    // Product ID 1167: POWERPREP PLUS Practice Test 3 (SKU: 5478) - Only for Total Access
    var practiceTest3 = findSkuByProductId(1167);
    if (practiceTest3) {
        bundle2.push(practiceTest3);
    }

    // Product ID 1177: Official GRE Guide eBook (SKU: 6541) - for Total Access and Premium
    var greGuide = findSkuByProductId(1177);
    if (greGuide) {
        // For eBook version, we want SKU 6541 (eBook), not 6542 (Paperback)
        var greGuideEbook = findSkuBySkuId(6541);
        if (greGuideEbook) {
            bundle2.push(greGuideEbook);
            bundle3.push(greGuideEbook);
        }
    }

    // Product ID 300: ScoreItNow Writing Practice (SKU: 2801) - Only for Total Access
    var writingPractice = findSkuByProductId(300);
    if (writingPractice) {
        bundle2.push(writingPractice);
    }

    // Product ID 1175: Official GRE Verbal Reasoning (SKU: 6535) - Only for Total Access
    var verbalReasoning = findSkuByProductId(1175);
    if (verbalReasoning) {
        // For eBook version, we want SKU 6535 (eBook)
        var verbalReasoningEbook = findSkuBySkuId(6535);
        if (verbalReasoningEbook) {
            bundle2.push(verbalReasoningEbook);
        }
    }

    // Product ID 1174: Official GRE Quantitative Reasoning (SKU: 6532) - Only for Total Access
    var quantReasoning = findSkuByProductId(1174);
    if (quantReasoning) {
        // For eBook version, we want SKU 6532 (eBook)
        var quantReasoningEbook = findSkuBySkuId(6532);
        if (quantReasoningEbook) {
            bundle2.push(quantReasoningEbook);
        }
    }

    // Product ID 1169: GRE Vocabulary Flashcards (SKU: 6526) - Only for Total Access
    var vocabFlashcards = findSkuByProductId(1169);
    if (vocabFlashcards) {
        bundle2.push(vocabFlashcards);
    }

    bundleReady = true;
}

// Initialize product list from API response
function initializeProductList() {
    var customerId = (typeof customer_id !== 'undefined' && customer_id) ? customer_id : '5RGB62E8'
    var customerCountryCode = 'CN';
    var countryCode = customerCountryCode || 'IND'; // Default to IND if not available
    $.ajax({
        type: 'GET',
        url: '/ereg/public/api/products?countryCode=' + encodeURIComponent(countryCode) + '&languageCode=EN&customerId=' + customerId,
        async: false, // Make it synchronous to ensure data is loaded before bundle initialization
        success: function(data) {
            productList = data;
        },
        error: function(xhr) {
            console.error('Failed to load products:', xhr.status, xhr.responseText);
            // Fallback to empty array if API fails
            productList = [];
        }
    });
}

// Helper function to find SKU by product ID from the API response
function findSkuByProductId(productId) {
    // Loop through all categories
    for (var i = 0; i < productList.length; i++) {
        var category = productList[i];
        // Loop through products in each category
        for (var j = 0; j < category.products.length; j++) {
            var product = category.products[j];
            if (product.id === productId) {
                // Return the first available SKU (you can modify this logic if needed)
                if (product.skus && product.skus.length > 0) {
                    var sku = product.skus[0]; // Taking first SKU, modify if you need specific logic
                    return {
                        skuId: sku.id,
                        productName: product.formattedName || product.name,
                        categoryName: category.name,
                        fulfillmentType: sku.fulfillmentType,
                        price: sku.price,
                        productId: product.id,
                        variant:sku.optionValue,
                        name:product.name,
                        defaultCategoryId:category.id,
                        currencyCode: sku.sellerOfRecordPrice.currencyCode,
                        imageUrl: product.imageUrl
                    };
                }
            }
        }
    }
    return null;
}

// Helper function to find SKU by SKU ID (for cases where you know the SKU ID directly)
function findSkuBySkuId(skuId) {
    // Loop through all categories
    for (var i = 0; i < productList.length; i++) {
        var category = productList[i];
        // Loop through products in each category
        for (var j = 0; j < category.products.length; j++) {
            var product = category.products[j];
            // Loop through SKUs in each product
            for (var k = 0; k < product.skus.length; k++) {
                var sku = product.skus[k];
                if (sku.id === skuId) {
                    return {
                        skuId: sku.id,
                        productName: product.formattedName || product.name,
                        categoryName: category.name,
                        fulfillmentType: sku.fulfillmentType,
                        price: sku.price,
                        productId: product.id,
                        variant:sku.optionValue,
                        name:product.name,
                        defaultCategoryId:category.id,
                        currencyCode: sku.sellerOfRecordPrice.currencyCode,
                        imageUrl: product.imageUrl
                    };
                }
            }
        }
    }
    return null;
}


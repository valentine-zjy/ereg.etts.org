<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css">







<script>

var clearTimerMap = new Map();
var isAdminSite = false;

loadEregMsgsByPattern(".*", true, isAdminSite);

function getCountdown(target_date){
	var days, hours, minutes, seconds;
	// find the amount of "seconds" between now and target
	var current_date = new Date().getTime();
	var seconds_left = (target_date - current_date) / 1000;	  
	if ( seconds_left > 0 ) {
		if(seconds_left < 30){
			$('#extraTimeConfirmModal').modal("hide");
		}
		days = pad( parseInt(seconds_left / 86400) );
		seconds_left = seconds_left % 86400;
			 
		hours = pad( parseInt(seconds_left / 3600) );
		seconds_left = seconds_left % 3600;
			  
		minutes = pad( parseInt(seconds_left / 60) );
		seconds = pad( parseInt( seconds_left % 60 ) );
		
		if(hours > 0){
			return "Time remaining before seat is released : <span>" + hours + "</span> hours <span>" + minutes + "</span> mins <span>" + seconds + "</span> secs";
		}
		if(minutes > 0){
			return "Time remaining before seat is released : <span>" + minutes + "</span> mins <span>" + seconds + "</span> secs";
		}
		return "Time remaining before seat is released : <span>" + seconds + "</span> secs";
	}else{
		clearExistingTimerInterval();
		$('#countDownTimer').hide();
		$('#extraTimeConfirmModal').modal("hide");
	}
}

function pad(n) {
	return (n < 10 ? '0' : '') + n;
}

function clearExistingTimerInterval(){
	for (let key of clearTimerMap.keys()) {
		clearTimerMap.set(key,true);
	}
}

function resetExtendHoldRemainingSeconds() {
	$.get(CONTEXT_PATH + "/cart/updatedHoldRemainingSeconds", {}, function(timerRemainingSecnds) {
		$('#set-time').val(timerRemainingSecnds);
		prepareCountDownTimer(true);
    });
}

function setPaddingTopForHeader(){
		var headerHeight = $('#template-header').outerHeight();
		$('#scroll-margin-style').remove();
		$('<style id="scroll-margin-style"> * { scroll-margin-top: ' + headerHeight + 'px } </style>').appendTo("head");
		$('#template-wrapper').css('padding-top', headerHeight);
	}

	$(window).resize(function() {
    		setPaddingTopForHeader();
    	});

function prepareCountDownTimer(isExtendHoldAvailable){
	clearExistingTimerInterval();
	var timerSeconds = $('#set-time').val();
	if(timerSeconds && timerSeconds > 0){
		var target_date = new Date().getTime() + (timerSeconds * 1000); // set the countdown date
		var countdown = document.getElementById("countdown-timer-tiles"); // get tag element
		
		var timerId = setInterval(function(){
			if(!clearTimerMap.has(timerId)){
				clearTimerMap.set(timerId, false);} // timerId not(!) prasent in map, adding it.
			if(clearTimerMap.get(timerId)){
				clearInterval(timerId);} // if the map value is true; timer wil be cleared.
			else{
				countdown.innerHTML = getCountdown(target_date);}
		}, 1000);
		
		if(isExtendHoldAvailable){
			var messageShownInLastSeconds = (5 * 60);
			if(timerSeconds > messageShownInLastSeconds){
				var time_limit_for_message_inMilliSeconds = ((timerSeconds - messageShownInLastSeconds) * 1000);
				setTimeout(function(){$("#extraTimeConfirmModal").modal("show"); }, time_limit_for_message_inMilliSeconds);
			}
		}
		$('#countDownTimer').show();
	}else{
		$('#countDownTimer').hide();
		$('#extraTimeConfirmModal').modal("hide");
	}
	setPaddingTopForHeader();
}

$(document).ready(function() {
	prepareCountDownTimer(true);
	$(document.body).on("click", "#extraTimeRequired", function() {
		$.ajax({
		   	type: "POST",
			url: '/ereg'+"/register/extendRegistrationHold",
			contentType: "application/json; charset=utf-8",
			success: function(extendedHoldSeconds){
				if(extendedHoldSeconds && extendedHoldSeconds > 0){
					$('#set-time').val(extendedHoldSeconds);
					prepareCountDownTimer(false);
				}
			},
			error: function (xhr, ajaxOptions, thrownError) {
		  	// console.log(xhr.responseText);
		  }
		});
		$('#extraTimeConfirmModal').modal("hide");
	});
	
	var launchModalOnClick = "#template-header a:not(.dropdown-toggle),#admin-header a:not(.dropdown-toggle)";
	
	$(document.body).on("click", launchModalOnClick, function(e) {
		
		var showCancelPopUp='';
		
		if(showCancelPopUp =='true'){
			e.preventDefault();	
			if ($(this).hasClass('logComment')) {
				logComment();
			}else if ($(this).hasClass('resetPassword')) {
               openResetPasswordModal();
            }else{
			var redirectUrl = $(this).prop("href");
			$("#testRegRedirectUrl").val(redirectUrl);
			$("#cancelConfirm").modal("show");
			}
		}else{
			if ($(this).hasClass('logComment')) {
				logComment();
			}else if ($(this).hasClass('resetPassword')) {
               openResetPasswordModal();
            }else{
			    e.preventDefault();
				var redirectUrl = $(this).prop("href");
				window.location.href = redirectUrl;
			}
		}
		
	});
	
	$(document.body).on("click", "#dialogOk", function(e) {
		e.preventDefault();
		cancelTestReg();
	});
	
	var isOAM = "";
	 if(isOAM){
			$("#securityDiv").children().text("Security Question");
		}else{
			$("#securityDiv").children().text("Manage Security Profile");
		} 
	
}); 
function cancelTestReg() {
	$.ajax({
        type: "GET",
        url : getContextPath() + "/workflowmanager/cancel/schlWorkflow",
        success: function(responseData){
       	 var redirectUrl = $("#testRegRedirectUrl").val();
       	 if (redirectUrl){
    	        window.location = redirectUrl;
    	      }
        },
        error: function () {
       	 console.log("error while calling cancel test reg");
        }
        
    });
}
</script>
